generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  username      String     @unique
  display_name  String
  password_hash String
  role          String     @default("staff") // "admin" | "team_lead" | "staff"
  staff_type_id String?
  staff_type    StaffType? @relation(fields: [staff_type_id], references: [id])
  team_id       String?
  team          Team?      @relation("TeamMembers", fields: [team_id], references: [id])
  led_teams     Team[]     @relation("TeamLead")
  created_at    DateTime   @default(now())

  pending_logins        PendingLogin[]
  announcement_receipts AnnouncementReceipt[]
  assigned_properties   PropertyStaff[]
}

model Department {
  id         String     @id @default(cuid())
  name       String     @unique
  created_at DateTime   @default(now())
  pipelines  Pipeline[]
}

model StaffType {
  id                  String   @id @default(cuid())
  name                String   @unique
  permissions         Json // array of permissions
  allowed_departments Json // array of Department IDs
  allowed_pipelines   Json // array of Pipeline IDs
  created_at          DateTime @default(now())
  users               User[]
}

model Team {
  id         String   @id @default(cuid())
  name       String   @unique
  lead_id    String?
  lead       User?    @relation("TeamLead", fields: [lead_id], references: [id])
  members    User[]   @relation("TeamMembers")
  tickets    Ticket[]
  created_at DateTime @default(now())
}

model Pipeline {
  id                String     @id @default(cuid())
  label             String
  code              String
  stages            Json // array of stage names
  tag_field         Json // options and SLA days
  category_field    Json? // options for the legacy category dropdown
  department_id     String
  department        Department @relation(fields: [department_id], references: [id])
  default_checklist Json // array of checklist items
  ticket_fields     Json? // array of custom fields shown on the ticket form
  created_by        String
  created_at        DateTime   @default(now())

  tickets Ticket[]
}

model Ticket {
  id               String    @id @default(cuid())
  title            String
  property         String?
  unit             String?
  tag              String?
  assigned_to      String?
  stage_index      Int       @default(0)
  checklist        Json // current checklist state
  history          Json // stage transition history
  created_at       DateTime  @default(now())
  stage_entered_at DateTime  @default(now())
  completed_at     DateTime?
  due_date         DateTime?
  team_id          String?
  team             Team?     @relation(fields: [team_id], references: [id])
  priority         String?
  fields           Json? // custom field values (from pipeline.ticket_fields)

  pipeline_id String
  pipeline    Pipeline @relation(fields: [pipeline_id], references: [id])

  notes Note[]
}

model Note {
  id         String   @id @default(cuid())
  text       String
  author     String
  created_at DateTime @default(now())

  ticket_id String
  ticket    Ticket @relation(fields: [ticket_id], references: [id])
}

model PendingLogin {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  codeHash  String // bcrypt hash of the 6-digit code
  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model ContactType {
  id         String    @id @default(cuid())
  name       String    @unique // e.g., "Contractor", "Tenant", "Vendor"
  contacts   Contact[]
  created_at DateTime  @default(now())
}

model Contact {
  id              String      @id @default(cuid())
  name            String // Full Name or Company Name
  phone           String?
  email           String?
  mailing_address String?
  city            String?
  state           String?
  zip             String?
  notes           String?
  status          String      @default("active") // active | archived
  type_id         String
  contact_type    ContactType @relation(fields: [type_id], references: [id])

  properties PropertyContact[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([city, state])
  @@index([zip])
}

model Property {
  id         String   @id @default(cuid())
  name       String // Property Name
  address    String?
  city       String?
  state      String?
  zip        String?
  status     String   @default("active") // active | archived
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  contacts PropertyContact[]
  staff    PropertyStaff[]
}

model PropertyContact {
  contact_id  String
  property_id String
  contact     Contact  @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  property    Property @relation(fields: [property_id], references: [id], onDelete: Cascade)

  @@id([contact_id, property_id])
}

model PropertyStaff {
  user_id     String
  property_id String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  property    Property @relation(fields: [property_id], references: [id], onDelete: Cascade)

  @@id([user_id, property_id])
}

// A PolicyCategory is an admin-configurable section of the staff knowledge
// dashboard (e.g. "Company Policies", "Processing Procedures", "Resources").
model PolicyCategory {
  id                   String   @id @default(cuid())
  name                 String   @unique // e.g., "Maintenance Procedures"
  description          String?
  order                Int      @default(0)
  audience_staff_types Json? // array of StaffType IDs; empty/null = visible to all staff
  created_at           DateTime @default(now())
  policies             Policy[]
}

model Policy {
  id          String         @id @default(cuid())
  title       String
  description String?
  content     String
  status      String         @default("draft") // draft | published | archived
  category_id String
  category    PolicyCategory @relation(fields: [category_id], references: [id])
  order       Int            @default(0)

  attachments Json? // array of { name, url }

  created_by String
  updated_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Announcement {
  id          String  @id @default(cuid())
  title       String
  content     String
  priority    String  @default("normal") // normal | important | urgent
  target_type String // all | user | team | staff_type
  target_id   String? // legacy single target; superseded by target_ids
  target_ids  Json? // array of user / team / staff_type IDs (null if 'all')

  require_ack   Boolean   @default(false)
  publish_at    DateTime  @default(now())
  expires_at    DateTime?
  status        String    @default("sent") // scheduled | sent | cancelled. Defaults to "sent" so pre-existing rows are never re-dispatched; the API sets "scheduled" explicitly.
  dispatched_at DateTime?

  created_by String
  updated_by String?
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  receipts AnnouncementReceipt[]

  @@index([status, publish_at])
}

model AnnouncementReceipt {
  id              String       @id @default(cuid())
  announcement_id String
  announcement    Announcement @relation(fields: [announcement_id], references: [id], onDelete: Cascade)
  user_id         String
  user            User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  status       String    @default("sent") // sent | delivered | viewed | acknowledged
  sent_at      DateTime  @default(now())
  delivered_at DateTime?
  viewed_at    DateTime?
  ack_at       DateTime?

  @@unique([announcement_id, user_id])
}
